++++++++  { id: "scholarship", nameTh: "ข่าวทุน/วิจัย", nameEn: "Scholarships", categoryMatch: "ข่าวทุน/วิจัย" },
++++++++  { id: "event", nameTh: "ข่าวกิจกรรม", nameEn: "Events", categoryMatch: "ข่าวกิจกรรม/ศิลปวัฒนธรรม" },
