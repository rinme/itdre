+    { id: "bachelor", titleTh: "ระดับปริญญาตรี (วท.บ. / วศ.บ.)", titleEn: "Bachelor's Degrees", icon: BookOpen },
+    { id: "master", titleTh: "ระดับปริญญาโท (วท.ม.)", titleEn: "Master's Degrees", icon: Award },
